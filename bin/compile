#!/usr/bin/env bash
# Usage: bin/compile <build-dir> <cache-dir> <env-dir>

set -euo pipefail

BUILD_DIR="${1}"
CACHE_DIR="${2}"
ENV_DIR="${3}"

DOTNET_CNB_VERSION="0.1.6"

# Paths and directories
BUILDPACK_DIR=$(cd "$(dirname "$(dirname "${BASH_SOURCE[0]}")")" && pwd)
CNB_BUILD_DIR="/app/.heroku/cnb/dotnet"
CNB_CACHE_DIR="${CACHE_DIR}/.heroku/cnb/dotnet"
PROFILE_PATH="$BUILD_DIR/.profile.d/dotnet.sh"

# Cached items (both directory and corresponding .toml file will be
# cached and restored)
BUILD_CACHE_LAYERS=("sdk" "nuget-cache")

# Initialize environment
initialize_environment() {
    mkdir -p "$(dirname "$PROFILE_PATH")"
    mkdir -p "$BUILD_DIR/.heroku/cnb/dotnet"
    mkdir -p "$(dirname "$CNB_BUILD_DIR")"

    # Setup symlink from "/app/.heroku/cnb/dotnet" pointing to
    # the actual build directory. This allows the CNB to write
    # path environment variables that work both at runtime and
    # during the builds (particularly useful when a cached layer
    # is restored, and the build dir has changed).
    ln -nsf "$BUILD_DIR/.heroku/cnb/dotnet" "$CNB_BUILD_DIR"
    touch "$CNB_BUILD_DIR/buildpack_plan.toml"
    mkdir -p "$CNB_BUILD_DIR"/{layers,platform}

    export CNB_BUILDPACK_DIR="${BUILDPACK_DIR}/cnb"
    export CNB_TARGET_OS="linux"
    export CNB_TARGET_ARCH="amd64"
    export CNB_TARGET_DISTRO_NAME="ubuntu"
    export CNB_TARGET_DISTRO_VERSION="24.04"
    export CNB_BUILD_DIR CNB_CACHE_DIR

    cd $BUILD_DIR
}

download_and_extract_cnb() {
    local buildpack_url="https://github.com/heroku/buildpacks-dotnet/releases/download/v${DOTNET_CNB_VERSION}/heroku_dotnet_${CNB_TARGET_OS}-${CNB_TARGET_ARCH}.cnb"

    # Use a temporary directory for intermediate files, automatically cleaned up on exit
    local temp_dir
    temp_dir=$(mktemp -d) || { echo "Failed to create temp directory"; exit 1; }

    # Step 1: Download the CNB buildpack file
    echo "Downloading CNB buildpack from $buildpack_url..."
    local cnb_archive="$temp_dir/buildpack.cnb"
    curl -L "$buildpack_url" -o "$cnb_archive"

    # Step 2: Ensure the oci-image directory exists and extract the CNB buildpack file
    echo "Extracting CNB buildpack..."
    mkdir -p "$temp_dir/oci-image"  # Create the oci-image directory
    tar -xf "$cnb_archive" -C "$temp_dir/oci-image"

    # Step 3: Locate the manifest digest from index.json
    local index_file="$temp_dir/oci-image/index.json"
    local manifest_digest
    manifest_digest=$(jq -r '.manifests[0].digest' "$index_file")

    # Step 4: Extract the manifest file using the digest
    local manifest_file="$temp_dir/oci-image/blobs/sha256/${manifest_digest#sha256:}"
    if [ ! -f "$manifest_file" ]; then
        echo "Error: Manifest file $manifest_file not found."
        return 1
    fi

    # Step 5: Prepare the target directory and extract layers from the manifest file
    mkdir -p "$CNB_BUILDPACK_DIR"
    echo "Extracting layers from manifest..."
    jq -r '.layers[].digest' "$manifest_file" | while read -r layer_digest; do
        local layer_file="$temp_dir/oci-image/blobs/sha256/${layer_digest#sha256:}"
        
        # Extract each layer, skipping if the file is missing
        if [ -f "$layer_file" ]; then
            echo "Extracting layer $layer_file..."
            tar --strip-components=4 -xf "$layer_file" -C "$CNB_BUILDPACK_DIR"
        else
            echo "Warning: Layer $layer_file not found, skipping."
        fi
    done

    find "$CNB_BUILDPACK_DIR"

    rm -rf "$temp_dir"

    echo "Extraction complete. Relevant files are located in $CNB_BUILDPACK_DIR."
}

move_cnb_layer() {
    local src_dir="$1/layers"
    local dest_dir="$2/layers"
    local layer_name="$3"

    # Move layer directory if it exists
    if [ -d "$src_dir/$layer_name" ]; then
        mv "$src_dir/$layer_name" "$dest_dir/"
    fi

    # Move layer metadata file (.toml) if it exists
    if [ -f "$src_dir/$layer_name.toml" ]; then
        mv "$src_dir/$layer_name.toml" "$dest_dir/"
    fi
}

restore_build_cache() {
    for layer_name in "${BUILD_CACHE_LAYERS[@]}"; do
        move_cnb_layer "$CNB_CACHE_DIR" "$CNB_BUILD_DIR" "$layer_name"
    done
}

save_build_cache() {
    rm -rf "$CNB_CACHE_DIR" # Ensure old cache is cleared
    mkdir -p "$CNB_CACHE_DIR/layers"
    for layer_name in "${BUILD_CACHE_LAYERS[@]}"; do
        move_cnb_layer "$CNB_BUILD_DIR" "$CNB_CACHE_DIR" "$layer_name"
    done
}

# Function to format CNB output with consistent color handling and custom prefixes
format_cnb_output() {
    while IFS= read -r line; do
        color_code=''  # Holds any detected initial color code
        clean_line="$line"

        # Detect and store an ANSI color code at the start of the line, if present
        if [[ "$line" =~ ^($'\x1b['[0-9;]*'m') ]]; then
            color_code="${BASH_REMATCH[1]}"
            clean_line="${line#"$color_code"}"  # Remove color code for processing
        fi

        # Set prefix based on line pattern
        case "$clean_line" in
            "##"*)    prefix='----->'; content="${clean_line:2}" ;;
            "-"*)     prefix='----->'; content="${clean_line:1}" ;;
            "  -"*)   prefix='      '; content="${clean_line:3}" ;;
            "!"*)     prefix=' !    '; content="${clean_line:1}" ;;
            *)        prefix='   ';    content="$clean_line" ;;
        esac

        # Output formatted line with original color code, custom prefix, and content
        echo "${color_code}${prefix}${content}"
    done
}

# Run build with formatted output
run_build() {
    find "$(pwd)"
    $CNB_BUILDPACK_DIR/bin/build "$CNB_BUILD_DIR/layers" "$CNB_BUILD_DIR/platform" "$CNB_BUILD_DIR/buildpack_plan.toml" | format_cnb_output
}

# Process environment variable files
process_env_files() {
    rm -f $PROFILE_PATH
    find "$CNB_BUILD_DIR/layers" -type f \( -path "*/env/*" -o -path "*/env.launch/*" \) | while read -r file; do
        process_env_file "$file" >> "$PROFILE_PATH"
    done
}

process_env_file() {
    local env_file="$1"
    local var_name=$(basename "$env_file" | cut -d '.' -f 1)
    local operation=$(basename "$env_file" | cut -d '.' -f 2)

    case "$operation" in
        "override") echo "export $var_name=\"$(cat "$env_file")\"" ;;
        "prepend")  echo "export $var_name=\"$(cat "$env_file"):\$$var_name\"" ;;
        "append")   echo "export $var_name=\"\$$var_name:$(cat "$env_file")\"" ;;
    esac
}

initialize_environment
download_and_extract_cnb
# restore_build_cache
run_build
process_env_files
# save_build_cache

# Remove cached layers from build directory to reduce slug size
# Note: These directories are moved to the cache when saving the build cache,
# so this is here to ensure the layers are removed when caching is disabled.
for item in "${BUILD_CACHE_LAYERS[@]}"; do
    rm -rf "$CNB_BUILD_DIR/layers/$item" "$CNB_BUILD_DIR/layers/$item.toml"
done
